# Copy this file to .env and complete the local credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=encuesta-salud

# Optional: overrides all DB_* values (useful for tests).
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/encuesta-salud?charset=utf8mb4

APP_HOST=127.0.0.1
APP_PORT=8000
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=50
MAX_BATCH_FILES=250
PROCESSING_WORKERS=2
